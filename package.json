{
	"name": "financial-game",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "pnpm i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"a11y": "node scripts/a11y/run.mjs",
		"a11y:axe": "playwright test",
		"a11y:lighthouse": "node scripts/a11y/lighthouse.mjs",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --strategy url cookie preferredLanguage baseLocale",
		"i18n:validate": "inlang validate --project ./project.inlang",
		"i18n:lint": "inlang lint --project ./project.inlang",
		"i18n:check": "pnpm i18n:validate && pnpm i18n:lint && vitest run src/lib/i18n/messages.test.ts",
		"prepare": "svelte-kit sync && pnpm i18n:compile || echo ''"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@inlang/cli": "^3.3.8",
		"@inlang/paraglide-js": "^2.25.4",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.2",
		"chrome-launcher": "^1.2.1",
		"daisyui": "^5.7.42",
		"lighthouse": "^13.5.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.0",
		"vite": "^8.1.0",
		"vitest": "^4.1.9"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource/dm-mono": "^5.3.0",
		"mongodb": "^7.6.0"
	}
}
