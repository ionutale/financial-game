# Copy to .env and fill in. All three variables are server-only — never prefix
# any of them with PUBLIC_, and never paste the placeholder values into Vercel.
# The full operator checklist is docs/deployment.md.

# MongoDB Atlas connection string (EU region — see docs/deployment.md §2).
# Leave unset in dev to use the in-process store. In production an unset URI
# silently does the same, so progress dies with each cold start: set it for
# both Production and Preview.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/financial-game

# Peppers the profile cookie before the digest is stored. Rotating it orphans
# every profile at once, so generate it once, keep a copy in a password manager,
# and never change it:
#   openssl rand -base64 32 | tr -d '\n'
# Required in production and preview; dev falls back to a known value.
PROFILE_PEPPER=change-me-to-a-long-random-string

# Shared secret Vercel sends as `Authorization: Bearer $CRON_SECRET` to the
# daily retention sweep. Vercel recommends at least 16 characters:
#   openssl rand -base64 32 | tr -d '\n'
# Without it /api/cron/retention refuses every request (fails closed), so the
# 12-month retention promise stops being enforced.
CRON_SECRET=change-me-to-a-long-random-string
