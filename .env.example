# Copy to .env and fill in. Both are server-only secrets; never prefix with PUBLIC_.

# MongoDB Atlas connection string. Leave unset to use the in-process dev store.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/financial-game

# Peppers the profile cookie before it is stored. Rotating it orphans every
# profile, so set it once. Required in production; dev falls back to a known value.
PROFILE_PEPPER=change-me-to-a-long-random-string

# Shared secret Vercel sends as `Authorization: Bearer $CRON_SECRET` to the daily
# retention sweep. Without it /api/cron/retention refuses every request.
CRON_SECRET=change-me-to-a-long-random-string
